#include "interrupt.h"
#include "xparameters.h"

#define INTC_DEV_ID 	XPAR_INTC_0_DEVICE_ID
#define TMR_DEV_ID		XPAR_TIMER_0_DEVICE_ID
#define UART_DEV_ID		XPAR_UART_0_DEVICE_ID

XIntc IntrController;

void TMR_ISR(void *CallbackRef)
{

}
int SetupInterruptSystem()
{
	int status;

	//1. 인터럽트 컨트롤러 초기화
	status = XIntc_Initialize(&IntrController, INTC_DEV_ID);
	if (status != XST_SUCCESS) {
		return XST_FAILURE;
	}
	//2-1. TMR_ISR 함수를 Intc와 연결
	status = XIntc_Connect(&IntrController, TMR_DEV_ID,
			(XInterruptHandler) TMR_ISR, (void*) 0);

	//2-2. TMR_ISR 함수를 Intc와 연결
		status = XIntc_Connect(&IntrController, UART_DEV_ID,
				(XInterruptHandler) UART_ISR, (void*) 0);
}
