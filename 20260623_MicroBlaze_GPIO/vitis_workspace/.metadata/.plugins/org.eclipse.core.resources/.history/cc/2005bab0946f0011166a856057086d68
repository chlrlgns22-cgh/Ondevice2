#include "StopWatch.h"

typedef enum {
	STOP =0,
	RUN,
	CLEAR
}; stopWatch_e

stopWatch_e stopWatchState;

void StopWatch_Init()
{
	LED_Init();
	FND_Init();
	Button_Init();

	stopWatchState = STOP;
}

void StopWatch_Excute()
{
	switch (stopWatchState){
	case STOP:
		break;
	case RUN:
		break;
	case CLEAR:
		break;
	default:
	}
}
