void FND_DispNUM(uint32_t num)
{
	static uint32_t fndDigitState = 0;
	fndDigitState = (fndDigitState + 1) % 4;

	FND_DispAllOff();

	uint32_t msec_data = num ;
	uint32_t sec_data = (num/10) %60;
	uint32_t min_data = (num/10/60) %60;
	uint32_t hour_data = (num/10/60/60) %24;

	switch (fndDigitState) {
	case 0:
		FND_DispDigit(msec_data % 10);
		FND_SelDigit(FND_DIGIT_0);
		break;

	case 1:
		FND_DispDigit(sec_data % 10);
		FND_SelDigit(FND_DIGIT_1);
		break;

	case 2:
		FND_DispDigit(sec_data / 10 % 10);
		FND_SelDigit(FND_DIGIT_2);
		break;

	case 3:
		FND_DispDigit(min_data  % 10);
		FND_SelDigit(FND_DIGIT_3);
		break;
	}
}

