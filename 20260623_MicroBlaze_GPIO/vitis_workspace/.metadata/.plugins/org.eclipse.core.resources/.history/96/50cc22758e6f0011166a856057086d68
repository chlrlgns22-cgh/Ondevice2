typedef enum {
	NO_ACT = 0, ACT_PUSHED, ACT_RELEASED
} button_status_e;

typedef enum {
	RELEASED = 0, PUSHED
} button_state_e;

void Button_Init()
{
	uint32_t btnPort = GPIO_GETCR(GPIOB);
	btnPort &= ~( 1<<4 | 1<<5);
	GPIO_SetMode(GPIOB, btnPort);
}

button_status_e Button_GetState()
{
static button_state_e prevState = RELEASED;
button_state_e curState = GPIO_ReadPin(GPIOB, GPIO_PIN_4) ? PUSHED : RELEASED;

if(prevState == RELEASED && curState == PUSHED){
	prevState = curState;
	delay_ms(5);
	return ACT_PUSHED;
}
else if(prevState == PUSHED && curState == RELEASED){
	prevState = curState;
	delay_ms(5);
	return ACT_RELEASED;
}

return NO_ACT;
}

