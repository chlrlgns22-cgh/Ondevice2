#include "delay.h"

uint32_t m_tick=0;

uint32_t millis()
{
	return mtick++;
}

void delay_sec(uint32_t seconds)
{
	sleep(seconds);
}

void delay_ms(uint32_t mseconds)
{
	uint32_t mseconds = msec *1000;
	usleep(mseconds);
}

void delay_us(uint32_t usec)
{
	usleep(ussec);
}


