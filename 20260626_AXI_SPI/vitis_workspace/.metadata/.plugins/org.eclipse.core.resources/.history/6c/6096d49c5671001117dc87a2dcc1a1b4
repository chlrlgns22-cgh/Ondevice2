#include "interrupt.h"
#include "../delay/delay.h"
#include "../../driver/FND/FND.h"
#include "../../driver/LED/LED.h"
#include "../../HAL/UART/UART.h"
#include "../../HAL/SPI/SPI.h"

XIntc IntrController;

extern uint8_t rx_data;

void TMR_ISR(void *CallbackRef)
{
    FND_Excute();
    incTick();
}

void UART_ISR(void *CallbackRef)
{
    rx_data = UART_Receive(UART0);
}

void SPI_ISR(void *CallbackRef)
{
    // Slave가 보낸 데이터 확인
    uint8_t slave_resp = SPI_MasterReceive();
    if (slave_resp == 'a') {
        LED_PinToggle(10);  // LED 10번 토글
    }

    // Master가 받은 명령 처리
    uint8_t slave_rx = SPI_SlaveReceive();
    if (slave_rx != 0) {
        rx_data = slave_rx;
    }
}

int SetupInterruptSystem()
{
    int status;

    // 1. 인터럽트 컨트롤러 초기화
    status = XIntc_Initialize(&IntrController, INTC_DEV_ID);
    if (status != XST_SUCCESS) {
        return XST_FAILURE;
    }

    // 2-1. TMR ISR 등록
    status = XIntc_Connect(&IntrController, TMR_VEC_ID,
                           (XInterruptHandler)TMR_ISR, (void *)0);
    if (status != XST_SUCCESS) {
        return XST_FAILURE;
    }

    // 2-2. UART ISR 등록
    status = XIntc_Connect(&IntrController, UART_VEC_ID,
                           (XInterruptHandler)UART_ISR, (void *)0);
    if (status != XST_SUCCESS) {
        return XST_FAILURE;
    }

    // 2-3. SPI ISR 등록 (Master done 인터럽트)
    status = XIntc_Connect(&IntrController, SPI_VEC_ID,
                           (XInterruptHandler)SPI_ISR, (void *)0);
    if (status != XST_SUCCESS) {
        return XST_FAILURE;
    }

    // 3. 인터럽트 컨트롤러 시작 (Hardware Mode)
    status = XIntc_Start(&IntrController, XIN_REAL_MODE);
    if (status != XST_SUCCESS) {
        return XST_FAILURE;
    }

    // 4. 각 인터럽트 활성화
    XIntc_Enable(&IntrController, TMR_VEC_ID);
    XIntc_Enable(&IntrController, UART_VEC_ID);
    XIntc_Enable(&IntrController, SPI_VEC_ID);

    // 5. MicroBlaze Exception 등록
    Xil_ExceptionInit();
    Xil_ExceptionRegisterHandler(XIL_EXCEPTION_ID_INT,
                                 (Xil_ExceptionHandler)XIntc_InterruptHandler,
                                 &IntrController);
    Xil_ExceptionEnable();

    return XST_SUCCESS;
}
